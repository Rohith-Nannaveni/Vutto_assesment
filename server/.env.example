# Copy to .env (never commit .env). Only variables the server actually reads are listed.
NODE_ENV=development
PORT=4000
# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bike-auction?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bike-auction
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_HOURS=8
# Comma-separated browser origins allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173
# Optional. Defaults: lax in development, none (Secure) in production
# COOKIE_SAMESITE=lax
LOG_LEVEL=info

# Seed script only (npm run seed)
ADMIN_NAME=Marketplace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Admin-2026
# Password shared by the demo buyer accounts. Demonstration only.
DEMO_USER_PASSWORD=DemoBuyer-2026
